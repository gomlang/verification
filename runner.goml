package main;

use std::bytes;
use std::env;
use std::fs;
use std::io;
use std::json;
use std::path;
use std::process;
use std::text;
use std::time;
use std::utf8;
use utf8::BytesUtf8;

pub struct Verification {
    pub root: string,
    pub libraries: string,
    pub home: string,
    pub goml: string,
    pub records: Vec[json::Value],
}

pub fn run_command(
    context: Verification,
    arguments: Vec[string],
    directory: string,
    binary: string,
    log: string,
    race: bool,
) -> Result[string, string] {
    run_command_timeout(
        context,
        arguments,
        directory,
        binary,
        log,
        race,
        time::Duration::from_seconds(600),
    )
}

pub fn run_command_timeout(
    context: Verification,
    arguments: Vec[string],
    directory: string,
    binary: string,
    log: string,
    race: bool,
    timeout: time::Duration,
) -> Result[string, string] {
    let started = time::Instant::now();
    if arguments.is_empty() {
        return Result::Err("cannot run an empty command");
    }
    fs::create_dir_all(path::parent(log).unwrap_or(directory)).map_err(|error| error.to_string())?;
    let stdout_log = path::absolute_structured(log + ".stdout").map_err(|error| error.to_string())?;
    let stderr_log = path::absolute_structured(log + ".stderr").map_err(|error| error.to_string())?;
    fs::write_bytes_structured(stdout_log, bytes::Bytes::new()).map_err(|error| error.to_string())?;
    fs::write_bytes_structured(stderr_log, bytes::Bytes::new()).map_err(|error| error.to_string())?;
    let redirected = Vec::from_array(
        [
            "-c",
            "exec >\"$1\" 2>\"$2\"; shift 2; exec \"$@\"",
            "verification",
            stdout_log,
            stderr_log,
        ],
    );
    redirected.extend(arguments);
    let mut command = process::Command::new("sh").args(redirected).current_dir(directory).env(
        "GOML_HOME",
        context.home,
    ).env("GOML_WORKSPACE", "off").env("GOML_VERIFY_ROOT", context.root).env(
        "GOML_VERIFY_DRIVER",
        context.goml,
    ).env("GOML_VERIFY_BINARY", binary).env("GOML_BUILD_JOBS", "2").env("GOML_SIMD", "native").input(
        bytes::Bytes::new(),
    );
    if race {
        command = command.env("GOFLAGS", env::var_structured("GOFLAGS").unwrap_or("") + " -race").env(
            "GORACE",
            "halt_on_error=1 atexit_sleep_ms=0",
        );
    }
    let output = command.output_timeout_structured(timeout);
    let (status, launch_stdout, launch_stderr, timed_out) = match output {
        Result::Ok(value) => (
            value.status().code().unwrap_or(-1),
            value.stdout(),
            value.stderr(),
            false,
        ),
        Result::Err(error) => (
            -1,
            bytes::Bytes::new(),
            bytes::Bytes::from_string(error.to_string()),
            error.kind() == io::ErrorKind::TimedOut,
        ),
    };
    let stdout = bytes::Builder::new();
    stdout.extend(
        fs::read_bytes_structured(stdout_log).map_err(|error| error.to_string())?.as_slice(),
    );
    stdout.extend(launch_stdout.as_slice());
    let stdout_bytes = stdout.finish();
    let stderr = bytes::Builder::new();
    stderr.extend(
        fs::read_bytes_structured(stderr_log).map_err(|error| error.to_string())?.as_slice(),
    );
    stderr.extend(launch_stderr.as_slice());
    let stderr_bytes = stderr.finish();
    let logged = bytes::Builder::new();
    logged.extend(stdout_bytes.slice(0, stdout_bytes.len()));
    logged.extend(stderr_bytes.slice(0, stderr_bytes.len()));
    fs::write_bytes_structured(log, logged.finish()).map_err(|error| error.to_string())?;
    context.records.push(
        json::object(
            Vec::from_array(
                [
                    ("command", json::to_value(arguments)?),
                    ("cwd", json::to_value(directory)?),
                    ("milliseconds", json::to_value(started.elapsed().as_milliseconds())?),
                    ("exit_code", json::to_value(status)?),
                    ("timed_out", json::to_value(timed_out)?),
                    ("timeout_ms", json::to_value(timeout.as_milliseconds())?),
                    ("log", json::to_value(log)?),
                    ("stdout_log", json::to_value(stdout_log)?),
                    ("stderr_log", json::to_value(stderr_log)?),
                ],
            ),
        ),
    );
    let stdout = stdout_bytes.to_string_utf8();
    let stderr = stderr_bytes.to_string_utf8();
    if status != 0 {
        io::eprintln(
            stdout.unwrap_or("<invalid UTF-8 stdout>") + stderr.unwrap_or("<invalid UTF-8 stderr>"),
        );
        return Result::Err("command failed; see " + log);
    }
    let stdout = stdout.map_err(|error| error.to_string() + "; see " + log)?;
    stderr.map_err(|error| error.to_string() + "; see " + log)?;
    io::println(
        "  " + path::file_stem(log).unwrap_or(log) + ": passed ("
            + started.elapsed().as_milliseconds().to_string()
            + " ms)",
    );
    Result::Ok(stdout)
}

fn driver(
    context: Verification,
    arguments: Vec[string],
    directory: string,
    binary: string,
    log: string,
    race: bool,
) -> Result[string, string] {
    let command = Vec::from_array([context.goml]);
    command.extend(arguments);
    run_command(context, command, directory, binary, log, race)
}

fn race_enabled(name: string) -> bool {
    Vec::from_array(
        [
            "redis",
            "pipeline",
            "sqlite",
            "sql",
            "tempfile",
            "notify",
            "walkdir",
            "http",
            "request",
            "llvm",
            "rope",
            "logos",
            "regexp",
            "tracing",
            "web",
            "ignore",
            "syntax",
            "cache",
            "bigint",
            "decimal",
            "incremental",
            "datetime",
            "terminal",
            "progress",
            "explorer",
            "fuzzy",
            "websocket",
            "config",
            "highlight",
            "archive",
            "compress",
            "textproto",
            "mime",
            "metrics",
            "csv",
            "bench",
            "uuid",
            "yaml",
            "jwt",
            "s3",
            "html",
            "image",
            "postgres",
            "protobuf",
            "oauth2",
            "cron",
        ],
    ).contains(name)
}

fn native_fixture(name: string) -> bool {
    Vec::from_array(["bench", "llvm", "postgres", "redis", "sql", "sqlite", "web", "yaml"]).contains(
        name,
    )
}

fn native_test_packages(name: string) -> Vec[string] {
    if name == "protobuf" {
        Vec::from_array(["./..."])
    } else if name == "request" || name == "oauth2" {
        Vec::from_array(["./testserver"])
    } else if Vec::from_array(["sqlite", "llvm", "html", "image", "yaml", "jwt", "postgres"]).contains(
        name,
    ) {
        Vec::from_array(["./adapter"])
    } else {
        Vec::new()
    }
}

fn example_name(name: string) -> string {
    match name {
        "diff" => "patch",
        "csv" => "inventory",
        "cli" => "parse",
        _ => "basic",
    }
}

fn sample_build_arguments(name: string, arguments: Vec[string]) -> Vec[string] {
    if !applications().contains(name) && !native_fixture(name) {
        arguments.push("--example");
        arguments.push(example_name(name));
    }
    arguments
}

fn verify_module(context: Verification, name: string, race: bool, logs: string) -> Result[
    (),
    string,
] {
    io::println("Verifying " + name);
    let library = path::join(context.libraries, name);
    let single = applications().contains(name);
    let fixture = native_fixture(name);
    let sample = if fixture {
        path::join(library, "testdata/downstream/native")
    } else {
        library
    };
    let runtime_directory = if single || fixture {
        sample
    } else {
        path::join(library, "examples/" + example_name(name))
    };
    let executable = if name == "goml_stats" {
        "cmd/goml_stats/goml_stats"
    } else if single || fixture {
        name
    } else {
        "examples/" + example_name(name) + "/" + example_name(name)
    };
    let binary = path::join(sample, "_artifact/bin/" + executable);
    let directories = Vec::from_array([(library, "library")]);
    if fixture {
        directories.push((sample, "downstream"));
    }
    for (directory, prefix) in directories {
        driver(
            context,
            Vec::from_array(["fmt", "--check"]),
            directory,
            binary,
            path::join(logs, prefix + "-format.log"),
            false,
        )?;
    }
    driver(
        context,
        sample_build_arguments(name, Vec::from_array(["build"])),
        sample,
        binary,
        path::join(logs, "sample-build.log"),
        false,
    )?;
    for (directory, prefix) in directories {
        driver(
            context,
            Vec::from_array(["test", "--timeout", "300s"]),
            directory,
            binary,
            path::join(logs, prefix + "-tests.log"),
            false,
        )?;
    }
    let native_packages = native_test_packages(name);
    let native_directory = if name == "protobuf" {
        path::join(library, "tools/oracle")
    } else {
        library
    };
    if !native_packages.is_empty() {
        let command = Vec::from_array(["go", "test", "-count=1"]);
        command.extend(native_packages);
        run_command(
            context,
            command,
            native_directory,
            binary,
            path::join(logs, "native-tests.log"),
            false,
        )?;
    }
    let generated = path::join(sample, "_artifact/build/pkg");
    let before = artifact_fingerprint(generated)?;
    driver(
        context,
        sample_build_arguments(name, Vec::from_array(["build"])),
        sample,
        binary,
        path::join(logs, "sample-cached-build.log"),
        false,
    )?;
    if before != artifact_fingerprint(generated)? {
        return Result::Err("cached build changed public artifacts: " + name);
    }
    let command = Vec::from_array([binary]);
    if name == "explorer" {
        command.push("--snapshot");
    }
    if name == "goml_stats" {
        command.push("--help");
    }
    let snapshot = run_command(
        context,
        command,
        runtime_directory,
        binary,
        path::join(logs, "sample-run.log"),
        false,
    )?;
    if name == "explorer" {
        let repeated = run_command(
            context,
            Vec::from_array([binary, "--demo"]),
            sample,
            binary,
            path::join(logs, "snapshot-repeat.log"),
            false,
        )?;
        if snapshot != repeated || !snapshot.contains("GoML terminal ecosystem")
            || !snapshot.contains("6/6")
            || snapshot.contains("\u001b") {
            return Result::Err("unstable explorer snapshot");
        }
    }
    if Vec::from_array(["terminal", "tui", "prompt", "progress", "tui_markdown", "explorer"]).contains(
        name,
    ) {
        let started = time::Instant::now();
        let result = verify_pty(name, binary);
        let log = path::join(logs, "pty.log");
        let description = match result {
            Result::Ok(()) => "PTY scenarios passed",
            Result::Err(error) => error,
        };
        fs::write_file_structured(log, description).map_err(|error| error.to_string())?;
        context.records.push(
            json::object(
                Vec::from_array(
                    [
                        ("check", json::to_value("pty")?),
                        ("module", json::to_value(name)?),
                        ("milliseconds", json::to_value(started.elapsed().as_milliseconds())?),
                        (
                            "exit_code",
                            json::to_value(
                                if result.is_ok() {
                                    0
                                } else {
                                    1
                                },
                            )?,
                        ),
                        ("log", json::to_value(log)?),
                    ],
                ),
            ),
        );
        result?;
        io::println("  pty: passed");
    }
    if name == "ndarray" {
        verify_simd(context, sample, binary, logs)?;
    }
    if name == "unicode_text" || name == "markdown" {
        let tools = path::join(library, "tools");
        driver(
            context,
            Vec::from_array(["fmt", "--check"]),
            tools,
            binary,
            path::join(logs, "data-tools-format.log"),
            false,
        )?;
        driver(
            context,
            Vec::from_array(["test", "--timeout", "300s"]),
            tools,
            binary,
            path::join(logs, "data-conformance.log"),
            false,
        )?;
    }
    if race && race_enabled(name) {
        let race_binary = path::join(sample, "_artifact/race/bin/" + executable);
        driver(
            context,
            sample_build_arguments(
                name,
                Vec::from_array(["build", "--target-dir", "_artifact/race"]),
            ),
            sample,
            race_binary,
            path::join(logs, "race-build.log"),
            true,
        )?;
        for (directory, prefix) in directories {
            driver(
                context,
                Vec::from_array(["test", "--target-dir", "_artifact/race", "--timeout", "300s"]),
                directory,
                race_binary,
                path::join(logs, prefix + "-race.log"),
                true,
            )?;
        }
        if !native_packages.is_empty() {
            let command = Vec::from_array(["go", "test", "-race", "-count=1"]);
            command.extend(native_packages);
            run_command(
                context,
                command,
                native_directory,
                race_binary,
                path::join(logs, "native-race.log"),
                true,
            )?;
        }
    }
    Result::Ok(())
}

pub fn verify_all(root: string, libraries: string, home: string, options: Options) -> Result[
    (),
    string,
] {
    let reports = path::join(root, "_artifact/verification");
    let logs = unique_directory(path::join(reports, "runs"), "run-")?;
    let context = Verification { root, libraries, home, goml: options.goml, records: Vec::new() };
    let mut result: Result[(), string] = Result::Ok(());
    let _ = write_report(context, options, logs, false, result)?;
    for name in options.selected {
        result = verify_module(context, name, options.race, path::join(logs, name));
        if result.is_err() {
            break;
        }
    }
    let report_path = write_report(context, options, logs, true, result).map_err(
        |report_error| {
            let diagnostic = "Could not write final report: " + report_error;
            match result {
                Result::Ok(()) => diagnostic,
                Result::Err(error) => error + "\n" + diagnostic,
            }
        },
    )?;
    io::println("Verification report: " + report_path);
    result
}

pub fn atomic_report(path: string, encoded: string) -> Result[(), string] {
    let absolute = absolute_input_path(path)?;
    let parent = absolute.byte_slice(0, text::rfind(absolute, "/").unwrap_or(0) + 1);
    fs::create_dir_all(parent).map_err(|error| error.to_string())?;
    let temporary = temporary_directory(resolve_directory(parent)?)?;
    let staged = path::join(temporary, "report.json");
    let result = fs::write_file_structured(staged, encoded).and_then(
        |_| fs::rename(staged, absolute),
    );
    let cleanup = fs::remove_dir_all(temporary).map_err(|error| error.to_string());
    result.map_err(|error| error.to_string())?;
    cleanup
}

fn write_report(
    context: Verification,
    options: Options,
    logs: string,
    completed: bool,
    result: Result[(), string],
) -> Result[string, string] {
    let report = json::object(
        Vec::from_array(
            [
                ("phase", json::Value::String("verification")),
                ("modules", json::to_value(options.selected)?),
                ("registry_home", json::to_value(context.home)?),
                ("run_directory", json::to_value(logs)?),
                ("completed", json::to_value(completed)?),
                ("success", json::to_value(completed && result.is_ok())?),
                (
                    "error",
                    match result {
                        Result::Ok(()) => json::Value::Null,
                        Result::Err(error) => json::Value::String(error),
                    },
                ),
                ("race", json::to_value(options.race)?),
                ("commands", json::to_value(context.records)?),
            ],
        ),
    );
    save_report(context.root, logs, report)
}

fn write_setup_report(
    root: string,
    arguments: Vec[string],
    phase: string,
    options: Option[Options],
    error: string,
) -> Result[string, string] {
    let logs = unique_directory(path::join(root, "_artifact/verification/runs"), "run-")?;
    let selected = match options {
        Option::Some(value) => value.selected,
        Option::None => Vec::new(),
    };
    let race = match options {
        Option::Some(value) => json::to_value(value.race)?,
        Option::None => json::Value::Null,
    };
    let report = json::object(
        Vec::from_array(
            [
                ("phase", json::Value::String(phase)),
                ("requested_arguments", json::to_value(arguments)?),
                ("modules", json::to_value(selected)?),
                ("registry_home", json::Value::Null),
                ("run_directory", json::Value::String(logs)),
                ("completed", json::Value::Bool(true)),
                ("success", json::Value::Bool(false)),
                ("error", json::Value::String(error)),
                ("race", race),
                ("commands", json::Value::Array(Vec::new())),
            ],
        ),
    );
    save_report(root, logs, report)
}

fn save_report(root: string, logs: string, report: json::Value) -> Result[string, string] {
    let encoded = json::encode(report) + "\n";
    atomic_report(path::join(logs, "report.json"), encoded)?;
    let report_path = env::var_structured("GOML_VERIFY_REPORT").unwrap_or(
        path::join(root, "_artifact/verification/report.json"),
    );
    atomic_report(report_path, encoded)?;
    Result::Ok(report_path)
}

package main;

use std::bytes;
use std::crypto::hash;
use std::crypto::rand;
use std::fs;
use std::path;
use std::toml;
use std::utf8;
use utf8::BytesUtf8;

pub struct SourceFile {
    pub name: string,
    pub content: bytes::Bytes,
}

pub struct CapturedModule {
    pub name: string,
    pub files: Vec[SourceFile],
}

pub fn applications() -> Vec[string] {
    Vec::from_array(["goml_stats", "explorer"])
}


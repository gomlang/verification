package tests;

use ecosystem::verification as verify;
use std::bytes;
use std::crypto::hash;
use std::fs;
use std::json;
use std::path;
use std::task;
use std::testing;
use std::toml;

fn fixture() -> string {
    let root = testing::expect_ok(
        verify::temporary_directory("_artifact/registry-tests"),
        "temporary registry root",
    );
    let root = testing::expect_ok(path::absolute_structured(root), "absolute registry root");
    for name in Vec::from_array(["one", "two"]) {
        let module = path::join(root, name);
        testing::assert_ok(fs::create_dir_all(path::join(module, "_artifact")));
        testing::assert_ok(
            fs::write_file_structured(
                path::join(module, "goml.toml"),
                "[module]\npath = \"ecosystem::" + name + "\"\n",
            ),
        );
        testing::assert_ok(
            fs::write_file_structured(path::join(module, "main.goml"), "package " + name + ";\n"),
        );
        testing::assert_ok(
            fs::write_file_structured(path::join(module, "_artifact/ignored"), "generated output"),
        );
    }
    root
}

fn check_snapshot(home: string, one_source: string) -> () {
    let registry = path::join(home, "cache/registry");
    let source = testing::expect_ok(
        fs::read_file_structured(path::join(registry, "index.toml")),
        "registry index",
    );
    let index = testing::expect_ok(toml::parse(source), "valid registry TOML");
    let modules = testing::expect_some(
        toml::field(index, "modules").and_then(|value| toml::as_table(value)),
        "registry modules",
    );
    testing::assert_eq(modules.len(), 2);
    for name in Vec::from_array(["one", "two"]) {
        let directory = path::join(registry, "ecosystem/" + name + "/0.1.0");
        let source = testing::expect_ok(
            fs::read_file_structured(path::join(directory, "main.goml")),
            "captured source",
        );
        testing::assert_eq(
            source,
            if name == "one" {
                one_source
            } else {
                "package two;\n"
            },
        );
        testing::assert(!fs::exists(path::join(directory, "_artifact")));
    }
}

fn write_manifest(root: string, relative: string, content: string) -> () {
    let directory = path::join(root, relative);
    testing::assert_ok(fs::create_dir_all(directory));
    testing::assert_ok(fs::write_file_structured(path::join(directory, "goml.toml"), content));
}

fn snapshot_names(home: string) -> Vec[string] {
    let content = testing::expect_ok(
        fs::read_file_structured(path::join(home, "cache/registry/index.toml")),
        "registry index",
    );
    let document = testing::expect_ok(toml::parse(content), "registry index TOML");
    let entries = testing::expect_some(
        toml::field(document, "modules").and_then(|value| toml::as_table(value)),
        "registry modules",
    );
    let names = Vec::new();
    for (name, _) in entries {
        names.push(name);
    }
    names
}

#[test]
fn selected_snapshot_only_requires_selected_checkout_and_dependencies() -> () {
    let root = fixture();
    let first = testing::expect_ok(
        verify::registry_snapshot(root, root, Vec::from_array(["one"])),
        "snapshot a partial checkout",
    );
    testing::assert(snapshot_names(first) == Vec::from_array(["ecosystem::one"]));
    write_manifest(root, "two", "invalid TOML in an unrelated checkout");
    let second = testing::expect_ok(
        verify::registry_snapshot(root, root, Vec::from_array(["one", "one"])),
        "unrelated checkouts and duplicate selections do not affect a snapshot",
    );
    testing::assert_eq(first, second);
    testing::assert_ok(fs::remove_dir_all(root));
}

#[test]
fn snapshot_follows_transitive_dev_and_nested_fixture_dependencies() -> () {
    let root = fixture();
    write_manifest(
        root,
        "one",
        "[module]\npath = \"ecosystem::one\"\n[dependencies]\n\"ecosystem::two\" = \"0.1.0\"\n",
    );
    write_manifest(
        root,
        "two",
        "[module]\npath = \"ecosystem::two\"\n[dev-dependencies]\n\"ecosystem::one\" = \"0.1.0\"\n",
    );
    write_manifest(
        root,
        "two/testdata/downstream/native",
        "[module]\npath = \"downstream::native\"\n[dev-dependencies]\n\"ecosystem::three\" = \"0.1.0\"\n",
    );
    write_manifest(root, "three", "[module]\npath = \"ecosystem::three\"\n");
    let home = testing::expect_ok(
        verify::registry_snapshot(root, root, Vec::from_array(["one"])),
        "snapshot transitive dependencies and cycles",
    );
    testing::assert(
        snapshot_names(home)
            == Vec::from_array(["ecosystem::one", "ecosystem::three", "ecosystem::two"]),
    );
    testing::assert(
        !fs::exists(
            path::join(home, "cache/registry/ecosystem/two/0.1.0/testdata/downstream/native"),
        ),
    );
    testing::assert_ok(fs::remove_dir_all(root));
}

#[test]
fn snapshot_reports_missing_selection_and_dependency_sources() -> () {
    let root = fixture();
    let error = testing::expect_err(
        verify::registry_snapshot(root, root, Vec::from_array(["absent"])),
        "missing selection",
    );
    testing::assert(error.contains("selected module absent"));
    write_manifest(
        root,
        "one/testdata/downstream/native",
        "[dependencies]\n\"ecosystem::absent\" = \"0.1.0\"\n",
    );
    let error = testing::expect_err(
        verify::registry_snapshot(root, root, Vec::from_array(["one"])),
        "missing fixture dependency",
    );
    testing::assert(error.contains("dependency absent"));
    testing::assert(error.contains("one/testdata/downstream/native/goml.toml"));
    testing::assert(!fs::exists(path::join(root, "_artifact/registry-snapshots")));
    let all = testing::expect_ok(verify::parse_options(Vec::new(), root), "default selection");
    testing::assert_err(verify::registry_snapshot(root, root, all.selected));
    testing::assert_ok(fs::remove_dir_all(root));
}

#[test]
fn consumer_selection_discovers_dependencies_without_publishing_consumer() -> () {
    let root = fixture();
    write_manifest(
        root,
        "explorer",
        "[module]\npath = \"example::explorer\"\n[dependencies]\n\"ecosystem::one\" = \"0.1.0\"\n",
    );
    let home = testing::expect_ok(
        verify::registry_snapshot(root, root, Vec::from_array(["explorer"])),
        "consumer dependencies",
    );
    testing::assert(snapshot_names(home) == Vec::from_array(["ecosystem::one"]));
    testing::assert_ok(fs::remove_dir_all(root));
}

#[test]
fn dependency_discovery_and_snapshot_exclude_generated_directories_and_symlinks() -> () {
    let root = fixture();
    write_manifest(
        root,
        "one",
        "[module]\npath = \"ecosystem::one\"\n[build]\ntarget-dir = \"build/cache\"\n",
    );
    write_manifest(
        root,
        "one/testdata/downstream/native",
        "[module]\npath = \"downstream::native\"\n[build]\ntarget-dir = \"generated\"\n[dependencies]\n\"ecosystem::two\" = \"0.1.0\"\n",
    );
    for relative in Vec::from_array(
        [
            "_artifact",
            "_bootstrap",
            ".git",
            "__pycache__",
            ".goml",
            ".cache",
            "node_modules",
            "vendor",
            "build/cache",
            "testdata/downstream/native/generated",
        ],
    ) {
        write_manifest(root, "one/" + relative + "/ignored-manifest", "invalid generated TOML");
    }
    write_manifest(root, "external", "[dependencies]\n\"ecosystem::missing\" = \"0.1.0\"\n");
    testing::assert_ok(
        fs::symbolic_link(path::join(root, "external"), path::join(root, "one/linked-directory")),
    );
    testing::assert_ok(fs::create_dir_all(path::join(root, "one/linked-manifest")));
    testing::assert_ok(
        fs::write_file_structured(
            path::join(root, "one/linked-manifest/data.txt"),
            "source fixture",
        ),
    );
    testing::assert_ok(
        fs::symbolic_link(
            path::join(root, "external/goml.toml"),
            path::join(root, "one/linked-manifest/goml.toml"),
        ),
    );
    let home = testing::expect_ok(
        verify::registry_snapshot(root, root, Vec::from_array(["one"])),
        "ignore generated and linked manifests",
    );
    testing::assert(snapshot_names(home) == Vec::from_array(["ecosystem::one", "ecosystem::two"]));
    let directory = path::join(home, "cache/registry/ecosystem/one/0.1.0");
    testing::assert_eq(
        testing::expect_ok(
            fs::read_file_structured(path::join(directory, "linked-manifest/data.txt")),
            "files beside a linked manifest remain source files",
        ),
        "source fixture",
    );
    for relative in Vec::from_array(
        [
            "_artifact",
            "_bootstrap",
            ".git",
            "__pycache__",
            ".goml",
            ".cache",
            "node_modules",
            "vendor",
            "build/cache",
            "linked-directory",
            "linked-manifest/goml.toml",
        ],
    ) {
        testing::assert(!fs::exists(path::join(directory, relative)));
    }
    let reordered = testing::expect_ok(
        verify::registry_snapshot(root, root, Vec::from_array(["two", "one"])),
        "same closure regardless of selection order",
    );
    testing::assert_eq(home, reordered);
    testing::assert_ok(fs::remove_dir_all(root));
}

#[test]
fn dependency_discovery_rejects_unsafe_paths_and_linked_checkouts() -> () {
    let root = fixture();
    for target in Vec::from_array(["", ".", "/tmp", "../outside", "build/../cache"]) {
        write_manifest(
            root,
            "one",
            "[module]\npath = \"ecosystem::one\"\n[build]\ntarget-dir = \"" + target + "\"\n",
        );
        let error = testing::expect_err(
            verify::registry_snapshot(root, root, Vec::from_array(["one"])),
            "unsafe build output",
        );
        testing::assert(error.contains("invalid build target directory"));
    }
    write_manifest(
        root,
        "one",
        "[module]\npath = \"ecosystem::one\"\n[dependencies]\n\"ecosystem::../outside\" = \"0.1.0\"\n",
    );
    let error = testing::expect_err(
        verify::registry_snapshot(root, root, Vec::from_array(["one"])),
        "unsafe dependency",
    );
    testing::assert(error.contains("invalid module directory"));
    testing::assert(error.contains("one/goml.toml"));
    testing::assert_ok(fs::symbolic_link(path::join(root, "two"), path::join(root, "linked")));
    testing::assert_err(verify::registry_snapshot(root, root, Vec::from_array(["linked"])));
    testing::assert_ok(fs::remove_file(path::join(root, "one/goml.toml")));
    testing::assert_ok(
        fs::symbolic_link(path::join(root, "two/goml.toml"), path::join(root, "one/goml.toml")),
    );
    testing::assert_err(verify::registry_snapshot(root, root, Vec::from_array(["one"])));
    testing::assert_ok(fs::remove_dir_all(root));
}

#[test]
fn concurrent_publication_only_exposes_complete_identical_snapshots() -> () {
    let root = fixture();
    let homes = task::scope(
        |scope| {
            let jobs = Vec::new();
            for _ in 0..8 {
                jobs.push(
                    scope.spawn(
                        |_| {
                            let captured = testing::expect_ok(
                                verify::capture_modules(root, Vec::from_array(["one", "two"])),
                                "capture modules",
                            );
                            let home = testing::expect_ok(
                                verify::publish_snapshot(root, captured),
                                "publish snapshot",
                            );
                            check_snapshot(home, "package one;\n");
                            home
                        },
                    ),
                );
            }
            task::join_all(jobs)
        },
    );
    for home in homes {
        testing::assert_eq(home, homes[0]);
    }
    let entries = testing::expect_ok(
        fs::read_dir_names_structured(path::join(root, "_artifact/registry-snapshots")),
        "snapshot entries",
    );
    testing::assert_eq(entries.len(), 1);
    testing::assert_ok(fs::remove_dir_all(root));
}

#[test]
fn snapshot_hash_and_sources_use_the_same_captured_bytes() -> () {
    let root = fixture();
    let names = Vec::from_array(["one", "two"]);
    let captured = testing::expect_ok(verify::capture_modules(root, names), "capture modules");
    testing::assert_ok(
        fs::write_file_structured(path::join(root, "one/main.goml"), "package changed;\n"),
    );
    let first = testing::expect_ok(
        verify::publish_snapshot(root, captured),
        "publish captured snapshot",
    );
    check_snapshot(first, "package one;\n");
    let changed = testing::expect_ok(
        verify::capture_modules(root, names),
        "capture changed modules",
    );
    let second = testing::expect_ok(
        verify::publish_snapshot(root, changed),
        "publish changed snapshot",
    );
    testing::assert_ne(first, second);
    check_snapshot(second, "package changed;\n");
    testing::assert_ok(fs::remove_dir_all(root));
}

#[test]
fn invalid_coordinate_never_publishes_partial_registry() -> () {
    let root = fixture();
    testing::assert_ok(
        fs::write_file_structured(
            path::join(root, "two/goml.toml"),
            "[module]\npath = \"unexpected::two\"\n",
        ),
    );
    let error = testing::expect_err(
        verify::capture_modules(root, Vec::from_array(["one", "two"])),
        "reject module coordinate",
    );
    testing::assert(error.contains("unexpected module coordinate"));
    testing::assert(!fs::exists(path::join(root, "_artifact/registry-snapshots")));
    testing::assert_err(verify::capture_modules(root, Vec::from_array(["../outside"])));
    testing::assert_ok(fs::remove_dir_all(root));
}

#[test]
fn registry_skips_symlinks_and_keeps_binary_sources() -> () {
    let root = fixture();
    testing::assert_ok(fs::symbolic_link(root, path::join(root, "one/loop")));
    let raw = bytes::Bytes::from_vec(Vec::from_array([0.to_u8(), 255.to_u8(), 10.to_u8()]));
    testing::assert_ok(fs::write_bytes_structured(path::join(root, "one/raw.bin"), raw));
    let captured = testing::expect_ok(
        verify::capture_modules(root, Vec::from_array(["one", "two"])),
        "capture binary data",
    );
    let home = testing::expect_ok(verify::publish_snapshot(root, captured), "publish binary data");
    let target = path::join(home, "cache/registry/ecosystem/one/0.1.0");
    testing::assert(
        testing::expect_ok(
            fs::read_bytes_structured(path::join(target, "raw.bin")),
            "read binary data",
        ).to_vec()
            == raw.to_vec(),
    );
    testing::assert(!fs::exists(path::join(target, "loop")));
    testing::assert_ok(fs::remove_dir_all(root));
}

#[test]
fn registry_excludes_nested_downstream_module() -> () {
    let root = fixture();
    let downstream = path::join(root, "one/testdata/downstream/native");
    testing::assert_ok(fs::create_dir_all(downstream));
    testing::assert_ok(
        fs::write_file_structured(
            path::join(downstream, "goml.toml"),
            "[module]\npath = \"downstream::one\"\n",
        ),
    );
    let captured = testing::expect_ok(
        verify::capture_modules(root, Vec::from_array(["one", "two"])),
        "capture modules",
    );
    let home = testing::expect_ok(verify::publish_snapshot(root, captured), "publish snapshot");
    testing::assert(
        !fs::exists(
            path::join(home, "cache/registry/ecosystem/one/0.1.0/testdata/downstream/native"),
        ),
    );
    testing::assert_ok(fs::remove_dir_all(root));
}

#[test]
fn command_errors_are_recorded_and_options_reject_unknown_names() -> () {
    testing::assert_err(verify::parse_options(Vec::from_array(["--goml"]), "/repo"));
    testing::assert_err(verify::parse_options(Vec::from_array(["misspelled"]), "/repo"));
    let options = testing::expect_ok(
        verify::parse_options(Vec::from_array(["color", "--no-race", "color"]), "/repo"),
        "valid options",
    );
    testing::assert(options.selected == Vec::from_array(["color"]));
    testing::assert(!options.race);
    let root = fixture();
    let context = verify::Verification {
        root,
        libraries: root,
        home: root,
        goml: "/not-used",
        records: Vec::new(),
    };
    let log = path::join(root, "failure.log");
    testing::assert_err(
        verify::run_command(
            context,
            Vec::from_array(["sh", "-c", "printf failure >&2; exit 7"]),
            root,
            "",
            log,
            false,
        ),
    );
    testing::assert_eq(
        testing::expect_ok(fs::read_file_structured(log), "failed command log"),
        "failure",
    );
    testing::assert_eq(context.records.len(), 1);
    testing::assert_eq(
        json::field(context.records[0], "exit_code").and_then(|value| json::as_int(value)).unwrap_or(
            -1,
        ),
        7,
    );
    testing::assert_ok(fs::remove_dir_all(root));
}

#[test]
fn expanded_libraries_are_unique_and_available_to_the_runner() -> () {
    let libraries = verify::modules();
    testing::assert_eq(libraries.len(), 70);
    let unique = Vec::new();
    for name in libraries {
        testing::assert(!unique.contains(name));
        unique.push(name);
    }
    let requested = Vec::from_array(["uuid", "yaml", "jwt", "s3", "wasm", "goir"]);
    let options = testing::expect_ok(
        verify::parse_options(requested, "/repo"),
        "expanded library options",
    );
    testing::assert(options.selected == requested);
    let all = testing::expect_ok(verify::parse_options(Vec::new(), "/repo"), "all modules");
    testing::assert_eq(all.selected.len(), 72);
    testing::assert(all.selected.contains("goml_stats"));
    testing::assert(all.selected.contains("explorer"));
}

#[test]
fn fingerprints_frame_paths_containing_delimiters() -> () {
    let root = fixture();
    let first = path::join(root, "first");
    let second = path::join(root, "second");
    testing::assert_ok(fs::create_dir_all(first));
    testing::assert_ok(fs::write_file_structured(path::join(first, "a"), ""));
    testing::assert_ok(fs::write_file_structured(path::join(first, "b"), ""));
    testing::assert_ok(fs::create_dir_all(second));
    let name = "a:" + hash::sha256(bytes::Bytes::new()) + "\nb";
    testing::assert_ok(fs::write_file_structured(path::join(second, name), ""));
    testing::assert_ne(
        testing::expect_ok(verify::artifact_fingerprint(first), "separate file fingerprint"),
        testing::expect_ok(verify::artifact_fingerprint(second), "newline path fingerprint"),
    );
    testing::assert_ok(fs::remove_dir_all(root));
}

#[test]
fn malformed_command_output_is_logged_verbatim_and_rejected() -> () {
    let root = fixture();
    let context = verify::Verification {
        root,
        libraries: root,
        home: root,
        goml: "/not-used",
        records: Vec::new(),
    };
    let log = path::join(root, "binary.log");
    testing::assert_err(
        verify::run_command(
            context,
            Vec::from_array(["sh", "-c", "printf '\\377'"]),
            root,
            "",
            log,
            false,
        ),
    );
    let output = testing::expect_ok(fs::read_bytes_structured(log), "verbatim output");
    testing::assert(output.to_vec() == Vec::from_array([255.to_u8()]));
    testing::assert_eq(context.records.len(), 1);
    testing::assert_ok(fs::remove_dir_all(root));
}
